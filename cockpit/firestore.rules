rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && profile().data.active == true;
    }

    function userRole() {
      return profile().data.role;
    }

    function isEditor() {
      return activeUser() && userRole() in ['director', 'admin'];
    }

    function isAdmin() {
      return activeUser() && userRole() == 'admin';
    }

    function isDirector() {
      return activeUser() && userRole() == 'director';
    }

    function knownStatus(status) {
      return status in ['approved', 'needs_work', 'pending', 'deleted'];
    }

    function validSchedule(data) {
      return data.keys().hasAll(['title', 'dateKey', 'format', 'role', 'cta', 'source', 'tasksValentin', 'tasksAnnie', 'calendarTime', 'calendarDurationMinutes', 'calendarLocation', 'calendarCost', 'status', 'deleted', 'selected', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['title', 'dateKey', 'format', 'role', 'cta', 'source', 'tasksValentin', 'tasksAnnie', 'calendarTime', 'calendarDurationMinutes', 'calendarLocation', 'calendarCost', 'status', 'deleted', 'selected', 'updatedAt', 'updatedBy'])
        && data.title is string && data.title.size() <= 220
        && data.dateKey is string && data.dateKey.size() <= 80
        && data.format is string && data.format.size() <= 220
        && data.role is string && data.role.size() <= 5000
        && data.cta is string && data.cta.size() <= 220
        && data.source is string && data.source.size() <= 500
        && data.tasksValentin is list && data.tasksValentin.size() <= 8
        && data.tasksAnnie is list && data.tasksAnnie.size() <= 8
        && data.calendarTime is string && data.calendarTime.size() <= 20
        && data.calendarDurationMinutes is int && data.calendarDurationMinutes > 0 && data.calendarDurationMinutes <= 1440
        && data.calendarLocation is string && data.calendarLocation.size() <= 220
        && data.calendarCost is string && data.calendarCost.size() <= 500
        && knownStatus(data.status)
        && data.deleted is bool && data.deleted == (data.status == 'deleted')
        && data.selected is bool
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validComment(data) {
      return data.keys().hasAll(['sectionId', 'comment', 'quickTag', 'dictated', 'authorUid', 'authorLabel', 'deleted', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['sectionId', 'comment', 'quickTag', 'dictated', 'authorUid', 'authorLabel', 'deleted', 'resolved', 'resolvedAt', 'resolvedBy', 'resolvedByLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.sectionId is string && data.sectionId.size() <= 120
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 5000
        && (data.quickTag == null || data.quickTag in ['cancel', 'delay', 'perfect'])
        && data.dictated is bool
        && data.authorUid == request.auth.uid
        && data.authorLabel is string && data.authorLabel.size() > 0 && data.authorLabel.size() <= 120
        && data.deleted is bool
        && (!('resolved' in data) || data.resolved is bool)
        && (!('resolvedAt' in data) || data.resolvedAt == null || data.resolvedAt is timestamp)
        && (!('resolvedBy' in data) || data.resolvedBy is string)
        && (!('resolvedByLabel' in data) || (data.resolvedByLabel is string && data.resolvedByLabel.size() <= 120))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validWorkflow(data) {
      return data.keys().hasAll(['eventId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['eventId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.stage in ['proposal', 'content_review', 'changes_requested', 'content_changes_requested', 'content_approved', 'media_in_progress', 'media_review', 'media_changes_requested', 'final_approved', 'scheduled', 'published']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validOpportunityState(data) {
      return data.keys().hasAll(['opportunityId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['opportunityId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.opportunityId is string && data.opportunityId.size() >= 3 && data.opportunityId.size() <= 80
        && data.stage in ['watch', 'research', 'active', 'submitted', 'completed']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validInternalProjectState(data) {
      return data.keys().hasAll(['projectId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['projectId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.projectId is string && data.projectId.size() >= 3 && data.projectId.size() <= 80
        && data.stage in ['to_frame', 'planned', 'active', 'blocked', 'completed']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validEditorialDecision(data) {
      return data.keys().hasAll(['eventId', 'decision', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['eventId', 'decision', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.decision in ['undecided', 'chosen', 'deferred', 'rejected']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validAuditLog(data) {
      return data.keys().hasAll(['sectionId', 'action', 'userUid', 'userLabel', 'createdAt'])
        && data.keys().hasOnly(['sectionId', 'action', 'userUid', 'userLabel', 'createdAt'])
        && data.sectionId is string && data.sectionId.size() <= 120
        && data.action is string && data.action.size() > 0 && data.action.size() <= 120
        && data.userUid == request.auth.uid
        && data.userLabel is string && data.userLabel.size() > 0 && data.userLabel.size() <= 120
        && data.createdAt is timestamp;
    }

    function validFeedback(data) {
      return data.keys().hasAll(['sectionId', 'message', 'category', 'page', 'authorUid', 'authorLabel', 'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['sectionId', 'message', 'category', 'page', 'authorUid', 'authorLabel', 'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.sectionId is string && data.sectionId.size() <= 120
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.page is string && data.page.size() <= 240
        && data.authorUid is string
        && data.authorLabel is string && data.authorLabel.size() > 0 && data.authorLabel.size() <= 120
        && data.status in ['open', 'in_review', 'done']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy is string;
    }

    function validTask(data) {
      return data.keys().hasAll(['title', 'message', 'targetType', 'targetId', 'targetLabel', 'status', 'createdByUid', 'createdByLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['title', 'message', 'targetType', 'targetId', 'targetLabel', 'status', 'createdByUid', 'createdByLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 220
        && data.message is string && data.message.size() <= 5000
        && data.targetType in ['schedule', 'section']
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 160
        && data.targetLabel is string && data.targetLabel.size() <= 220
        && data.status in ['pending', 'done']
        && data.createdByUid is string && data.createdByUid.size() > 0
        && data.createdByLabel is string && data.createdByLabel.size() > 0 && data.createdByLabel.size() <= 120
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() > 0;
    }

    function validMediaLink(data) {
      return data.keys().hasAll(['eventId', 'label', 'url', 'kind', 'stage', 'note', 'archived', 'authorUid', 'authorLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['eventId', 'label', 'url', 'kind', 'stage', 'note', 'archived', 'authorUid', 'authorLabel', 'createdAt', 'updatedAt', 'updatedBy', 'selectedFinal', 'approvedAt', 'approvedBy', 'approvedByLabel'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.label is string && data.label.size() > 0 && data.label.size() <= 180
        && data.url is string && data.url.size() > 8 && data.url.size() <= 2048
        && data.kind in ['image', 'video', 'pdf', 'document', 'folder', 'other']
        && data.stage in ['source', 'draft', 'approved', 'published', 'reference']
        && data.note is string && data.note.size() <= 1000
        && data.archived is bool
        && data.authorUid is string && data.authorUid.size() > 0
        && data.authorLabel is string && data.authorLabel.size() > 0 && data.authorLabel.size() <= 120
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('selectedFinal' in data) || data.selectedFinal is bool)
        && (!('approvedBy' in data) || data.approvedBy is string)
        && (!('approvedByLabel' in data) || data.approvedByLabel is string)
        && data.updatedBy is string && data.updatedBy.size() > 0;
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /privateContent/{contentId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /privateContentVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /privateConfig/{configId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /scheduleItems/{itemId} {
      allow read: if activeUser();
      allow create: if isEditor() && validSchedule(request.resource.data);
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deleted', 'selected', 'updatedAt', 'updatedBy'])
        && validSchedule(request.resource.data);
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isEditor();
      allow create: if isEditor() && validComment(request.resource.data) && request.resource.data.deleted == false;
      allow update: if isEditor()
        && request.resource.data.authorUid == resource.data.authorUid
        && ((resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment', 'deleted', 'updatedAt', 'updatedBy'])
            && validComment(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy', 'resolvedByLabel', 'updatedAt', 'updatedBy'])
            && request.resource.data.resolved == true
            && request.resource.data.resolvedAt is timestamp
            && request.resource.data.resolvedBy == request.auth.uid
            && request.resource.data.resolvedByLabel is string
            && request.resource.data.resolvedByLabel.size() > 0
            && request.resource.data.resolvedByLabel.size() <= 120
            && request.resource.data.updatedBy == request.auth.uid));
      allow delete: if false;
    }

    match /workflowStates/{eventId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validWorkflow(request.resource.data) && request.resource.data.eventId == eventId;
      allow delete: if false;
    }

    match /opportunityStates/{opportunityId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validOpportunityState(request.resource.data) && request.resource.data.opportunityId == opportunityId;
      allow delete: if false;
    }

    match /internalProjectStates/{projectId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validInternalProjectState(request.resource.data) && request.resource.data.projectId == projectId;
      allow delete: if false;
    }

    match /editorialDecisions/{eventId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validEditorialDecision(request.resource.data) && request.resource.data.eventId == eventId;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isEditor() && validAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /cockpitFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isEditor()
        && validFeedback(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && validFeedback(request.resource.data)
        && request.resource.data.status in ['open', 'in_review', 'done']
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if activeUser() && (isAdmin() || resource.data.createdByUid == request.auth.uid);
      allow create: if isEditor()
        && validTask(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status == 'done'
          && request.resource.data.updatedBy == request.auth.uid)
        || (isEditor()
          && resource.data.createdByUid == request.auth.uid
          && validTask(request.resource.data)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }

    match /mediaLinks/{mediaId} {
      allow read: if activeUser();
      allow create: if isEditor()
        && validMediaLink(request.resource.data)
        && request.resource.data.archived == false
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'selectedFinal', 'approvedAt', 'approvedBy', 'approvedByLabel', 'updatedAt', 'updatedBy'])
        && validMediaLink(request.resource.data)
        && ((request.resource.data.archived == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'updatedAt', 'updatedBy']))
          || (isEditor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedFinal', 'approvedAt', 'approvedBy', 'approvedByLabel', 'updatedAt', 'updatedBy'])))
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /changeArchive/{archiveId} {
      allow read: if isAdmin();
      allow create: if isEditor()
        && request.resource.data.keys().hasAll(['entityType', 'entityId', 'action', 'before', 'after', 'actorUid', 'actorLabel', 'createdAt'])
        && request.resource.data.keys().hasOnly(['entityType', 'entityId', 'action', 'before', 'after', 'actorUid', 'actorLabel', 'createdAt'])
        && request.resource.data.entityType is string && request.resource.data.entityType.size() > 0 && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string && request.resource.data.entityId.size() > 0 && request.resource.data.entityId.size() <= 160
        && request.resource.data.action is string && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 160
        && request.resource.data.before is map && request.resource.data.after is map
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorLabel is string && request.resource.data.actorLabel.size() > 0 && request.resource.data.actorLabel.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
