rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && profile().data.active == true;
    }

    function userRole() {
      return profile().data.role;
    }

    function isEditor() {
      return activeUser() && userRole() in ['director', 'admin'];
    }

    function isAdmin() {
      return activeUser() && userRole() == 'admin';
    }

    function isDirector() {
      return activeUser() && userRole() == 'director';
    }

    function knownStatus(status) {
      return status in ['approved', 'needs_work', 'pending', 'deleted'];
    }

    function validSchedule(data) {
      return data.keys().hasAll(['title', 'dateKey', 'dateIso', 'format', 'role', 'cta', 'source', 'tasksValentin', 'tasksAnnie', 'calendarTime', 'calendarDurationMinutes', 'calendarLocation', 'calendarCost', 'status', 'deleted', 'selected', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['title', 'dateKey', 'dateIso', 'format', 'role', 'cta', 'source', 'tasksValentin', 'tasksAnnie', 'calendarTime', 'calendarDurationMinutes', 'calendarLocation', 'calendarCost', 'status', 'deleted', 'selected', 'updatedAt', 'updatedBy'])
        && data.title is string && data.title.size() <= 220
        && data.dateKey is string && data.dateKey.size() <= 80
        && data.dateIso is string && data.dateIso.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.format is string && data.format.size() <= 220
        && data.role is string && data.role.size() <= 5000
        && data.cta is string && data.cta.size() <= 220
        && data.source is string && data.source.size() <= 500
        && data.tasksValentin is list && data.tasksValentin.size() <= 8
        && data.tasksAnnie is list && data.tasksAnnie.size() <= 8
        && data.calendarTime is string && data.calendarTime.size() <= 20
        && data.calendarDurationMinutes is int && data.calendarDurationMinutes > 0 && data.calendarDurationMinutes <= 1440
        && data.calendarLocation is string && data.calendarLocation.size() <= 220
        && data.calendarCost is string && data.calendarCost.size() <= 500
        && knownStatus(data.status)
        && data.deleted is bool && data.deleted == (data.status == 'deleted')
        && data.selected is bool
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validComment(data) {
      return data.keys().hasAll(['sectionId', 'comment', 'quickTag', 'dictated', 'authorUid', 'authorLabel', 'deleted', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['sectionId', 'comment', 'quickTag', 'dictated', 'authorUid', 'authorLabel', 'deleted', 'resolved', 'resolvedAt', 'resolvedBy', 'resolvedByLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.sectionId is string && data.sectionId.size() <= 120
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 5000
        && (data.quickTag == null || data.quickTag in ['cancel', 'delay', 'perfect'])
        && data.dictated is bool
        && data.authorUid == request.auth.uid
        && data.authorLabel is string && data.authorLabel.size() > 0 && data.authorLabel.size() <= 120
        && data.deleted is bool
        && (!('resolved' in data) || data.resolved is bool)
        && (!('resolvedAt' in data) || data.resolvedAt == null || data.resolvedAt is timestamp)
        && (!('resolvedBy' in data) || data.resolvedBy is string)
        && (!('resolvedByLabel' in data) || (data.resolvedByLabel is string && data.resolvedByLabel.size() <= 120))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validWorkflow(data) {
      return data.keys().hasAll(['eventId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['eventId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.stage in ['proposal', 'content_review', 'changes_requested', 'content_changes_requested', 'content_approved', 'media_in_progress', 'media_review', 'media_changes_requested', 'final_approved', 'scheduled', 'published']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function workflowTextApproved(eventId) {
      // La porte texte doit être franchie avant la décision média. Lire l'état
      // existant casse le cycle getAfter décision <-> workflow et interdit de
      // faire approuver texte et visuel prématurément dans le même lot.
      return exists(/databases/$(database)/documents/workflowStates/$(eventId))
        && get(/databases/$(database)/documents/workflowStates/$(eventId)).data.stage
          in ['content_approved', 'media_in_progress', 'media_review', 'media_changes_requested', 'final_approved', 'scheduled', 'published'];
    }

    function validMediaDecisionSide(side, actorRole) {
      return side is map
        && side.keys().hasAll(['status', 'mediaIds', 'actorUid', 'actorLabel', 'actorRole', 'decidedAt'])
        && side.keys().hasOnly(['status', 'mediaIds', 'actorUid', 'actorLabel', 'actorRole', 'decidedAt'])
        && side.status in ['none', 'selected', 'revoked']
        && side.mediaIds is list && side.mediaIds.size() <= 1
        && ((side.status == 'selected' && side.mediaIds.size() == 1)
          || (side.status != 'selected' && side.mediaIds.size() == 0))
        && side.actorUid is string
        && side.actorLabel is string && side.actorLabel.size() <= 120
        && side.actorRole == actorRole
        && ((side.status == 'none' && side.actorUid == '' && side.actorLabel == '' && side.decidedAt == null)
          || (side.status != 'none' && side.actorUid.size() > 0 && side.actorLabel.size() > 0 && side.decidedAt is timestamp));
    }

    function validMediaOverride(value) {
      return value is map
        && value.keys().hasAll(['active', 'mediaIds', 'reason', 'actorUid', 'actorLabel', 'actorRole', 'decidedAt'])
        && value.keys().hasOnly(['active', 'mediaIds', 'reason', 'actorUid', 'actorLabel', 'actorRole', 'decidedAt'])
        && value.active is bool
        && value.mediaIds is list && value.mediaIds.size() <= 1
        && value.reason is string && value.reason.size() <= 500
        && value.actorUid is string
        && value.actorLabel is string && value.actorLabel.size() <= 120
        && value.actorRole in ['', 'director', 'admin']
        && ((value.active == false
            && value.mediaIds.size() == 0
            && value.reason == ''
            && value.actorUid == ''
            && value.actorLabel == ''
            && value.actorRole == ''
            && value.decidedAt == null)
          || (value.active == true
            && value.mediaIds.size() == 1
            && value.reason.size() > 0
            && value.actorUid.size() > 0
            && value.actorLabel.size() > 0
            && value.actorRole in ['director', 'admin']
            && value.decidedAt is timestamp));
    }

    function validSelectedMedia(eventId, side) {
      return side.status != 'selected'
        || validSelectableMedia(eventId, side.mediaIds[0]);
    }

    function validSelectableMedia(eventId, mediaId) {
      let path = /databases/$(database)/documents/mediaLinks/$(mediaId);
      let media = getAfter(path).data;
      return existsAfter(path)
        && media.eventId == eventId
        && media.archived == false
        && (!('publicationBlocked' in media) || media.publicationBlocked == false);
    }

    function validMediaAgreement(data) {
      return data.agreement is map
        && data.agreement.keys().hasAll(['status', 'mediaIds', 'divergent'])
        && data.agreement.keys().hasOnly(['status', 'mediaIds', 'divergent'])
        && data.agreement.status in ['pending', 'agreed', 'divergent', 'overridden']
        && data.agreement.mediaIds is list && data.agreement.mediaIds.size() <= 1
        && data.agreement.divergent is bool
        && ((data.agreement.status == 'agreed'
            && data.override.active == false
            && data.communications.status == 'selected'
            && data.direction.status == 'selected'
            && data.communications.mediaIds == data.direction.mediaIds
            && data.agreement.mediaIds == data.communications.mediaIds
            && data.agreement.divergent == false
            && workflowTextApproved(data.eventId))
          || (data.agreement.status == 'divergent'
            && data.override.active == false
            && data.communications.status == 'selected'
            && data.direction.status == 'selected'
            && data.communications.mediaIds != data.direction.mediaIds
            && data.agreement.mediaIds.size() == 0
            && data.agreement.divergent == true)
          || (data.agreement.status == 'overridden'
            && data.override.active == true
            && ((data.override.actorRole == 'director'
                && data.direction.status == 'selected'
                && data.override.mediaIds == data.direction.mediaIds)
              || (data.override.actorRole == 'admin'
                && data.communications.status == 'selected'
                && data.override.mediaIds == data.communications.mediaIds))
            && data.agreement.mediaIds == data.override.mediaIds
            && data.agreement.divergent == false
            && workflowTextApproved(data.eventId))
          || (data.agreement.status == 'pending'
            && data.override.active == false
            && data.agreement.mediaIds.size() == 0
            && data.agreement.divergent == false
            && !(data.communications.status == 'selected'
              && data.direction.status == 'selected'
              && data.communications.mediaIds != data.direction.mediaIds)
            && !(data.communications.status == 'selected'
              && data.direction.status == 'selected'
              && data.communications.mediaIds == data.direction.mediaIds
              && workflowTextApproved(data.eventId))));
    }

    function mediaWorkflowMatchesAgreement(data) {
      let workflowPath = /databases/$(database)/documents/workflowStates/$(data.eventId);
      return existsAfter(workflowPath)
        && ((data.agreement.status in ['agreed', 'overridden']
            && getAfter(workflowPath).data.stage in ['final_approved', 'scheduled', 'published'])
          || (!(data.agreement.status in ['agreed', 'overridden'])
            && !(getAfter(workflowPath).data.stage in ['final_approved', 'scheduled', 'published'])));
    }

    function validMediaDecisionEnvelope(data) {
      return data.keys().hasAll(['eventId', 'schemaVersion', 'communications', 'direction', 'override', 'agreement', 'textGateStage', 'lastMutationId', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['eventId', 'schemaVersion', 'communications', 'direction', 'override', 'agreement', 'textGateStage', 'lastMutationId', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.schemaVersion == 2
        && data.textGateStage in ['proposal', 'content_review', 'changes_requested', 'content_changes_requested', 'content_approved', 'media_in_progress', 'media_review', 'media_changes_requested', 'final_approved', 'scheduled', 'published']
        && data.lastMutationId is string && data.lastMutationId.size() > 0 && data.lastMutationId.size() <= 160
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validMediaDecision(data) {
      return validMediaDecisionEnvelope(data)
        && validMediaDecisionSide(data.communications, 'admin')
        && validMediaDecisionSide(data.direction, 'director')
        && validMediaOverride(data.override)
        && validSelectedMedia(data.eventId, data.communications)
        && validSelectedMedia(data.eventId, data.direction)
        && validMediaAgreement(data)
        && mediaWorkflowMatchesAgreement(data);
    }

    function mediaAgreementAfter(eventId) {
      return existsAfter(/databases/$(database)/documents/mediaDecisions/$(eventId))
        && getAfter(/databases/$(database)/documents/mediaDecisions/$(eventId)).data.agreement.status in ['agreed', 'overridden'];
    }

    function validOpportunityState(data) {
      return data.keys().hasAll(['opportunityId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['opportunityId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.opportunityId is string && data.opportunityId.size() >= 3 && data.opportunityId.size() <= 80
        && data.stage in ['watch', 'research', 'active', 'submitted', 'completed']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validInternalProjectState(data) {
      return data.keys().hasAll(['projectId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['projectId', 'stage', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.projectId is string && data.projectId.size() >= 3 && data.projectId.size() <= 80
        && data.stage in ['to_frame', 'planned', 'active', 'blocked', 'completed']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validEditorialDecision(data) {
      return data.keys().hasAll(['eventId', 'decision', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.keys().hasOnly(['eventId', 'decision', 'updatedAt', 'updatedBy', 'updatedByLabel'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.decision in ['undecided', 'chosen', 'deferred', 'rejected']
        && data.updatedAt is timestamp && data.updatedBy == request.auth.uid
        && data.updatedByLabel is string && data.updatedByLabel.size() > 0 && data.updatedByLabel.size() <= 120;
    }

    function validAuditLog(data) {
      return data.keys().hasAll(['sectionId', 'action', 'userUid', 'userLabel', 'createdAt'])
        && data.keys().hasOnly(['sectionId', 'action', 'userUid', 'userLabel', 'createdAt'])
        && data.sectionId is string && data.sectionId.size() <= 120
        && data.action is string && data.action.size() > 0 && data.action.size() <= 120
        && data.userUid == request.auth.uid
        && data.userLabel is string && data.userLabel.size() > 0 && data.userLabel.size() <= 120
        && data.createdAt is timestamp;
    }

    function validFeedback(data) {
      return data.keys().hasAll(['sectionId', 'message', 'category', 'page', 'authorUid', 'authorLabel', 'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['sectionId', 'message', 'category', 'page', 'authorUid', 'authorLabel', 'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.sectionId is string && data.sectionId.size() <= 120
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.page is string && data.page.size() <= 240
        && data.authorUid is string
        && data.authorLabel is string && data.authorLabel.size() > 0 && data.authorLabel.size() <= 120
        && data.status in ['open', 'in_review', 'done']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy is string;
    }

    function validTask(data) {
      return data.keys().hasAll(['title', 'message', 'targetType', 'targetId', 'targetLabel', 'status', 'createdByUid', 'createdByLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['title', 'message', 'targetType', 'targetId', 'targetLabel', 'status', 'createdByUid', 'createdByLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 220
        && data.message is string && data.message.size() <= 5000
        && data.targetType in ['schedule', 'section']
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 160
        && data.targetLabel is string && data.targetLabel.size() <= 220
        && data.status in ['pending', 'done']
        && data.createdByUid is string && data.createdByUid.size() > 0
        && data.createdByLabel is string && data.createdByLabel.size() > 0 && data.createdByLabel.size() <= 120
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() > 0;
    }

    function actionPriorityToken(priorityKey) {
      return priorityKey < 10 ? '000' + string(priorityKey)
        : priorityKey < 100 ? '00' + string(priorityKey)
        : priorityKey < 1000 ? '0' + string(priorityKey)
        : string(priorityKey);
    }

    function expectedActionQueueKey(data, actionItemId) {
      return 'aq1|' + string(data.assigneeUid.size()) + '|' + data.assigneeUid + '|' + data.assigneeRole + '|'
        + (data.state == 'pending' ? 'p' : 'd') + '|'
        + actionPriorityToken(data.priorityKey) + '|'
        + data.eventDateIso + '|' + actionItemId;
    }

    function personalPendingQueuePrefix() {
      return 'aq1|' + string(request.auth.uid.size()) + '|' + request.auth.uid + '|' + userRole() + '|p|';
    }

    function validActionItem(data, actionItemId) {
      return actionItemId is string && actionItemId.matches('^[A-Za-z0-9_-]{3,180}$')
        && data.keys().hasAll(['assigneeUid', 'assigneeRole', 'state', 'queueKey', 'sourceType', 'sourceId', 'mediaId', 'eventDateIso', 'actionType', 'title', 'message', 'priorityKey', 'createdByUid', 'createdAt', 'updatedAt', 'updatedBy', 'lastMutationId', 'schemaVersion'])
        && data.keys().hasOnly(['assigneeUid', 'assigneeRole', 'state', 'queueKey', 'sourceType', 'sourceId', 'mediaId', 'eventDateIso', 'actionType', 'title', 'message', 'priorityKey', 'createdByUid', 'createdAt', 'updatedAt', 'updatedBy', 'lastMutationId', 'schemaVersion'])
        && data.assigneeUid is string && data.assigneeUid.size() > 0 && data.assigneeUid.size() <= 128
        && data.assigneeRole in ['director', 'admin']
        && data.state in ['pending', 'done']
        && data.queueKey is string && data.queueKey.size() > 0 && data.queueKey.size() <= 1400
        && data.sourceType in ['schedule', 'section', 'opportunity', 'internalProject']
        && data.sourceId is string && data.sourceId.size() > 0 && data.sourceId.size() <= 160
        && data.mediaId is string && data.mediaId.size() <= 180
        && data.eventDateIso is string && data.eventDateIso.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.actionType is string && data.actionType.size() > 0 && data.actionType.size() <= 80
        && data.title is string && data.title.size() > 0 && data.title.size() <= 220
        && data.message is string && data.message.size() <= 1500
        && data.priorityKey is int && data.priorityKey >= 0 && data.priorityKey <= 9999
        && data.queueKey == expectedActionQueueKey(data, actionItemId)
        && data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.lastMutationId is string && data.lastMutationId.size() > 0 && data.lastMutationId.size() <= 160
        && data.schemaVersion == 1;
    }

    function validMediaLink(data) {
      return data.keys().hasAll(['eventId', 'label', 'url', 'kind', 'stage', 'note', 'archived', 'authorUid', 'authorLabel', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['eventId', 'label', 'url', 'kind', 'stage', 'note', 'archived', 'authorUid', 'authorLabel', 'createdAt', 'updatedAt', 'updatedBy', 'selectedFinal', 'approvedAt', 'approvedBy', 'approvedByLabel', 'publicationBlocked', 'altText', 'rightsStatus'])
        && data.eventId is string && data.eventId.size() >= 3 && data.eventId.size() <= 80
        && data.label is string && data.label.size() > 0 && data.label.size() <= 180
        && data.url is string && data.url.size() > 8 && data.url.size() <= 2048
        && data.kind in ['image', 'video', 'pdf', 'document', 'folder', 'other']
        && data.stage in ['source', 'proposal', 'draft', 'approved', 'published', 'reference']
        && data.note is string && data.note.size() <= 1000
        && data.archived is bool
        && data.authorUid is string && data.authorUid.size() > 0
        && data.authorLabel is string && data.authorLabel.size() > 0 && data.authorLabel.size() <= 120
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('selectedFinal' in data) || data.selectedFinal is bool)
        && (!('publicationBlocked' in data) || data.publicationBlocked is bool)
        && (!('altText' in data) || (data.altText is string && data.altText.size() <= 1000))
        && (!('rightsStatus' in data) || (data.rightsStatus is string && data.rightsStatus.size() <= 120))
        && (!('approvedBy' in data) || data.approvedBy is string)
        && (!('approvedByLabel' in data) || data.approvedByLabel is string)
        && data.updatedBy is string && data.updatedBy.size() > 0;
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /privateContent/{contentId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /privateContentVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /privateConfig/{configId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /scheduleItems/{itemId} {
      allow read: if activeUser();
      allow create: if isEditor() && validSchedule(request.resource.data);
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deleted', 'selected', 'updatedAt', 'updatedBy'])
        && validSchedule(request.resource.data);
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isEditor();
      allow create: if isEditor() && validComment(request.resource.data) && request.resource.data.deleted == false;
      allow update: if isEditor()
        && request.resource.data.authorUid == resource.data.authorUid
        && ((resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment', 'deleted', 'updatedAt', 'updatedBy'])
            && validComment(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy', 'resolvedByLabel', 'updatedAt', 'updatedBy'])
            && request.resource.data.resolved == true
            && request.resource.data.resolvedAt is timestamp
            && request.resource.data.resolvedBy == request.auth.uid
            && request.resource.data.resolvedByLabel is string
            && request.resource.data.resolvedByLabel.size() > 0
            && request.resource.data.resolvedByLabel.size() <= 120
            && request.resource.data.updatedBy == request.auth.uid));
      allow delete: if false;
    }

    match /workflowStates/{eventId} {
      allow read: if activeUser();
      allow create: if isEditor()
        && validWorkflow(request.resource.data)
        && request.resource.data.eventId == eventId
        && (!(request.resource.data.stage in ['final_approved', 'scheduled', 'published']) || mediaAgreementAfter(eventId))
        && (!(request.resource.data.stage in ['scheduled', 'published']) || isAdmin());
      allow update: if isEditor()
        && validWorkflow(request.resource.data)
        && request.resource.data.eventId == eventId
        && (isAdmin()
          || (!(request.resource.data.stage in ['scheduled', 'published'])
            && !(resource.data.stage in ['scheduled', 'published'])))
        && (!(request.resource.data.stage in ['final_approved', 'scheduled', 'published'])
          || resource.data.stage in ['final_approved', 'scheduled', 'published']
          || mediaAgreementAfter(eventId));
      allow delete: if false;
    }

    match /opportunityStates/{opportunityId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validOpportunityState(request.resource.data) && request.resource.data.opportunityId == opportunityId;
      allow delete: if false;
    }

    match /internalProjectStates/{projectId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validInternalProjectState(request.resource.data) && request.resource.data.projectId == projectId;
      allow delete: if false;
    }

    match /editorialDecisions/{eventId} {
      allow read: if activeUser();
      allow create, update: if isEditor() && validEditorialDecision(request.resource.data) && request.resource.data.eventId == eventId;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isEditor() && validAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /cockpitFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isEditor()
        && validFeedback(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && validFeedback(request.resource.data)
        && request.resource.data.status in ['open', 'in_review', 'done']
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if activeUser() && (isAdmin() || resource.data.createdByUid == request.auth.uid);
      allow create: if isEditor()
        && validTask(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status == 'done'
          && request.resource.data.updatedBy == request.auth.uid)
        || (isEditor()
          && resource.data.createdByUid == request.auth.uid
          && validTask(request.resource.data)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }

    match /actionItems/{actionItemId} {
      allow get: if activeUser()
        && resource.data.assigneeUid == request.auth.uid
        && resource.data.assigneeRole == userRole();
      allow list: if activeUser()
        && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 25
        && resource.data.queueKey >= personalPendingQueuePrefix()
        && resource.data.queueKey < personalPendingQueuePrefix() + '\uf8ff';
      allow create: if isEditor()
        && validActionItem(request.resource.data, actionItemId)
        && request.resource.data.state == 'pending'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)).data.role == request.resource.data.assigneeRole;
      allow update: if isEditor()
        && resource.data.assigneeUid == request.auth.uid
        && resource.data.assigneeRole == userRole()
        && validActionItem(request.resource.data, actionItemId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'queueKey', 'updatedAt', 'updatedBy', 'lastMutationId'])
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /mediaLinks/{mediaId} {
      allow read: if activeUser();
      allow create: if isEditor()
        && validMediaLink(request.resource.data)
        && request.resource.data.archived == false
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'selectedFinal', 'approvedAt', 'approvedBy', 'approvedByLabel', 'updatedAt', 'updatedBy'])
        && validMediaLink(request.resource.data)
        && ((request.resource.data.archived == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'updatedAt', 'updatedBy']))
          || (isEditor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedFinal', 'approvedAt', 'approvedBy', 'approvedByLabel', 'updatedAt', 'updatedBy'])
            && request.resource.data.selectedFinal is bool
            && (request.resource.data.selectedFinal == false
              || (resource.data.archived == false
                && (!('publicationBlocked' in resource.data) || resource.data.publicationBlocked == false)))))
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /mediaDecisions/{eventId} {
      allow read: if activeUser();
      allow create: if isEditor()
        && validMediaDecision(request.resource.data)
        && request.resource.data.eventId == eventId
          && ((isAdmin()
            && request.resource.data.direction.status == 'none'
            && request.resource.data.communications.actorUid == request.auth.uid
            && (request.resource.data.override.active == false
              || (request.resource.data.override.active == true
                && request.resource.data.override.actorUid == request.auth.uid
                && request.resource.data.override.actorRole == 'admin')))
          || (isDirector()
            && request.resource.data.communications.status == 'none'
            && request.resource.data.direction.actorUid == request.auth.uid
            && (request.resource.data.override.active == false
              || (request.resource.data.override.actorUid == request.auth.uid
                && request.resource.data.override.actorRole == 'director'))));
      allow update: if isEditor()
        && validMediaDecisionEnvelope(request.resource.data)
        && request.resource.data.eventId == eventId
        && mediaWorkflowMatchesAgreement(request.resource.data)
          && ((isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communications', 'override', 'agreement', 'textGateStage', 'lastMutationId', 'updatedAt', 'updatedBy', 'updatedByLabel'])
            && request.resource.data.direction == resource.data.direction
            && validMediaOverride(request.resource.data.override)
            && (request.resource.data.override == resource.data.override
              || (request.resource.data.override.active == true
                && request.resource.data.override.actorUid == request.auth.uid
                && request.resource.data.override.actorRole == 'admin'))
            && validMediaDecisionSide(request.resource.data.communications, 'admin')
            && validSelectedMedia(eventId, request.resource.data.communications)
            && validMediaAgreement(request.resource.data)
            && request.resource.data.communications.actorUid == request.auth.uid
            )
          || (isDirector()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['direction', 'override', 'agreement', 'textGateStage', 'lastMutationId', 'updatedAt', 'updatedBy', 'updatedByLabel'])
            && request.resource.data.communications == resource.data.communications
            && validMediaDecisionSide(request.resource.data.direction, 'director')
            && validMediaOverride(request.resource.data.override)
            && validSelectedMedia(eventId, request.resource.data.direction)
            && validMediaAgreement(request.resource.data)
            && request.resource.data.direction.actorUid == request.auth.uid
            && (request.resource.data.override.active == false
              || (request.resource.data.override.actorUid == request.auth.uid
                && request.resource.data.override.actorRole == 'director'))));
      allow delete: if false;
    }

    match /changeArchive/{archiveId} {
      allow read: if isAdmin();
      allow create: if isEditor()
        && request.resource.data.keys().hasAll(['entityType', 'entityId', 'action', 'before', 'after', 'actorUid', 'actorLabel', 'createdAt'])
        && request.resource.data.keys().hasOnly(['entityType', 'entityId', 'action', 'before', 'after', 'actorUid', 'actorLabel', 'createdAt'])
        && request.resource.data.entityType is string && request.resource.data.entityType.size() > 0 && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string && request.resource.data.entityId.size() > 0 && request.resource.data.entityId.size() <= 160
        && request.resource.data.action is string && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 160
        && request.resource.data.before is map && request.resource.data.after is map
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorLabel is string && request.resource.data.actorLabel.size() > 0 && request.resource.data.actorLabel.size() <= 120
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
